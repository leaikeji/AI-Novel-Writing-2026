{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.ai-novel-world-2026.invalid/contracts/narration-script-v1.schema.json",
  "title": "AI小说世界2026 Narration Script Contract v1",
  "description": "Frozen T3-A wire schema. Cross-field invariants are normative in backend/narration/script_contracts.py.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "taxonomy_version",
    "script_id",
    "script_version_id",
    "novel_id",
    "document_id",
    "revision_id",
    "source_content_hash",
    "source_length_utf16",
    "version_number",
    "parent_version_id",
    "state",
    "effective_policy",
    "analyzer_fingerprint",
    "rules_fingerprint",
    "settings_fingerprint",
    "requested_model_fingerprint",
    "actual_model_fingerprint",
    "anonymous_speakers",
    "scenes",
    "segments",
    "issues",
    "warning_count",
    "blocker_count",
    "immutable_hash",
    "approval"
  ],
  "properties": {
    "schema_version": {
      "const": "narration-script/1"
    },
    "taxonomy_version": {
      "const": "narration-review-taxonomy/1"
    },
    "script_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "script_version_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "novel_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "document_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "revision_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "source_content_hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "source_length_utf16": {
      "type": "integer",
      "minimum": 0
    },
    "version_number": {
      "type": "integer",
      "minimum": 1
    },
    "parent_version_id": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "state": {
      "enum": [
        "draft",
        "analyzing",
        "analyzed",
        "review_required",
        "approved",
        "failed"
      ]
    },
    "effective_policy": {
      "enum": [
        "blockers_only",
        "always_review"
      ]
    },
    "analyzer_fingerprint": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "rules_fingerprint": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "settings_fingerprint": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "requested_model_fingerprint": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "actual_model_fingerprint": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "anonymous_speakers": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/anonymous_speaker"
      }
    },
    "scenes": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/scene"
      }
    },
    "segments": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/segment"
      }
    },
    "issues": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/issue"
      }
    },
    "warning_count": {
      "type": "integer",
      "minimum": 0
    },
    "blocker_count": {
      "type": "integer",
      "minimum": 0
    },
    "immutable_hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "approval": {
      "anyOf": [
        {
          "$ref": "#/$defs/approval"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "$defs": {
    "uuid": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "nullable_uuid": {
      "anyOf": [
        { "$ref": "#/$defs/uuid" },
        { "type": "null" }
      ]
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "nullable_sha256": {
      "anyOf": [
        { "$ref": "#/$defs/sha256" },
        { "type": "null" }
      ]
    },
    "utf16_range": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "start",
        "end_exclusive"
      ],
      "properties": {
        "start": {
          "type": "integer",
          "minimum": 0
        },
        "end_exclusive": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "speaker": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "character_id",
        "anonymous_speaker_id",
        "group_key"
      ],
      "properties": {
        "kind": {
          "enum": [
            "narrator",
            "character",
            "anonymous",
            "group",
            "unknown"
          ]
        },
        "character_id": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "anonymous_speaker_id": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "group_key": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^grp1_[a-f0-9]{64}$"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "casting_target": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "binding_id",
        "character_id",
        "anonymous_speaker_id",
        "pool_id",
        "slot_id",
        "profile_id"
      ],
      "properties": {
        "kind": {
          "enum": [
            "character_binding",
            "anonymous_binding",
            "generic_slot",
            "profile"
          ]
        },
        "binding_id": { "$ref": "#/$defs/nullable_uuid" },
        "character_id": { "$ref": "#/$defs/nullable_uuid" },
        "anonymous_speaker_id": { "$ref": "#/$defs/nullable_uuid" },
        "pool_id": { "$ref": "#/$defs/nullable_uuid" },
        "slot_id": { "$ref": "#/$defs/nullable_uuid" },
        "profile_id": { "$ref": "#/$defs/nullable_uuid" }
      }
    },
    "casting": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contract_version",
        "candidate_targets",
        "final_target",
        "origin",
        "rule_id",
        "rule_version"
      ],
      "properties": {
        "contract_version": { "const": "narration-casting-decision/1" },
        "candidate_targets": {
          "type": "array",
          "maxItems": 32,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/casting_target" }
        },
        "final_target": {
          "anyOf": [
            { "$ref": "#/$defs/casting_target" },
            { "type": "null" }
          ]
        },
        "origin": {
          "enum": [
            "narrator_setting",
            "character_binding",
            "anonymous_binding",
            "casting_rule",
            "manual_override",
            "unresolved",
            "not_applicable"
          ]
        },
        "rule_id": { "$ref": "#/$defs/nullable_uuid" },
        "rule_version": {
          "anyOf": [
            { "type": "integer", "minimum": 1 },
            { "type": "null" }
          ]
        }
      }
    },
    "override_provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contract_version",
        "kind",
        "action_id",
        "owner_actor_id",
        "recorded_at",
        "source_script_version_id",
        "source_segment_id",
        "source_immutable_hash",
        "source_local_hash",
        "source_anchor_before_hash",
        "source_anchor_after_hash",
        "speaker_target_hash"
      ],
      "properties": {
        "contract_version": { "const": "narration-override-provenance/1" },
        "kind": { "enum": ["manual_current", "inherited"] },
        "action_id": { "$ref": "#/$defs/uuid" },
        "owner_actor_id": { "type": "string", "minLength": 1, "maxLength": 120 },
        "recorded_at": {
          "type": "string",
          "format": "date-time",
          "pattern": "(?:Z|\\+00:00)$"
        },
        "source_script_version_id": { "$ref": "#/$defs/nullable_uuid" },
        "source_segment_id": { "$ref": "#/$defs/nullable_uuid" },
        "source_immutable_hash": { "$ref": "#/$defs/nullable_sha256" },
        "source_local_hash": { "$ref": "#/$defs/sha256" },
        "source_anchor_before_hash": { "$ref": "#/$defs/nullable_sha256" },
        "source_anchor_after_hash": { "$ref": "#/$defs/nullable_sha256" },
        "speaker_target_hash": { "$ref": "#/$defs/sha256" }
      }
    },
    "attribution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "origin",
        "rule_codes",
        "candidate_character_ids",
        "consent_id",
        "model_run_id",
        "input_digest_key_id",
        "input_digest",
        "output_digest",
        "override_provenance"
      ],
      "properties": {
        "origin": {
          "enum": [
            "local_rule",
            "cloud_assisted",
            "manual_override",
            "inherited_override"
          ]
        },
        "rule_codes": {
          "type": "array",
          "maxItems": 16,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_.-]{0,95}$"
          }
        },
        "candidate_character_ids": {
          "type": "array",
          "maxItems": 32,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/uuid" }
        },
        "consent_id": { "$ref": "#/$defs/nullable_uuid" },
        "model_run_id": { "$ref": "#/$defs/nullable_uuid" },
        "input_digest_key_id": {
          "anyOf": [
            { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,79}$" },
            { "type": "null" }
          ]
        },
        "input_digest": { "$ref": "#/$defs/nullable_sha256" },
        "output_digest": { "$ref": "#/$defs/nullable_sha256" },
        "override_provenance": {
          "anyOf": [
            { "$ref": "#/$defs/override_provenance" },
            { "type": "null" }
          ]
        }
      }
    },
    "anonymous_speaker": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "anonymous_speaker_id",
        "stable_key_algorithm",
        "stable_key",
        "display_name",
        "scope_kind",
        "scope_id",
        "confidence"
      ],
      "properties": {
        "anonymous_speaker_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "stable_key_algorithm": {
          "const": "anonymous-speaker-stable-key/1"
        },
        "stable_key": {
          "type": "string",
          "pattern": "^as1_[a-f0-9]{64}$"
        },
        "display_name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "scope_kind": {
          "enum": [
            "scene",
            "chapter",
            "novel"
          ]
        },
        "scope_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "confidence": {
          "enum": [
            "high",
            "medium",
            "low",
            "unknown"
          ]
        }
      }
    },
    "scene": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scene_id",
        "ordinal",
        "source_range_utf16",
        "boundary_source",
        "local_hash",
        "title"
      ],
      "properties": {
        "scene_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "ordinal": {
          "type": "integer",
          "minimum": 0
        },
        "source_range_utf16": {
          "anyOf": [
            {
              "$ref": "#/$defs/utf16_range"
            },
            {
              "type": "null"
            }
          ]
        },
        "boundary_source": {
          "enum": [
            "document_start",
            "markdown_heading",
            "scene_separator",
            "paragraph_rule",
            "manual"
          ]
        },
        "local_hash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "title": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 240
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "segment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "segment_id",
        "ordinal",
        "scene_id",
        "segment_kind",
        "source_block_kind",
        "paragraph_ordinal",
        "segment_ordinal_in_block",
        "source_block_key",
        "source_block_hash",
        "source_range_utf16",
        "source_text",
        "spoken_text",
        "local_hash",
        "anchor_before_hash",
        "anchor_after_hash",
        "inheritance_anchor_before_hash",
        "inheritance_anchor_after_hash",
        "speaker",
        "casting",
        "confidence",
        "emotion",
        "emotion_confidence",
        "delivery",
        "attribution",
        "pause_before_ms",
        "pause_after_ms",
        "manual_override"
      ],
      "properties": {
        "segment_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "ordinal": {
          "type": "integer",
          "minimum": 0
        },
        "scene_id": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "segment_kind": {
          "enum": [
            "narration",
            "dialogue",
            "inner_monologue",
            "message",
            "letter",
            "broadcast",
            "phone",
            "chapter_title",
            "synthetic_pause"
          ]
        },
        "source_block_kind": {
          "enum": [
            "paragraph",
            "heading",
            "message",
            "letter",
            "broadcast",
            "phone",
            "synthetic"
          ]
        },
        "paragraph_ordinal": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "segment_ordinal_in_block": {
          "type": "integer",
          "minimum": 0
        },
        "source_block_key": {
          "type": "string",
          "pattern": "^sb1_[a-f0-9]{64}$"
        },
        "source_block_hash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "source_range_utf16": {
          "anyOf": [
            {
              "$ref": "#/$defs/utf16_range"
            },
            {
              "type": "null"
            }
          ]
        },
        "source_text": {
          "type": "string"
        },
        "spoken_text": {
          "type": "string"
        },
        "local_hash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "anchor_before_hash": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "anchor_after_hash": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "inheritance_anchor_before_hash": {
          "$ref": "#/$defs/nullable_sha256"
        },
        "inheritance_anchor_after_hash": {
          "$ref": "#/$defs/nullable_sha256"
        },
        "speaker": {
          "$ref": "#/$defs/speaker"
        },
        "casting": {
          "$ref": "#/$defs/casting"
        },
        "confidence": {
          "enum": [
            "high",
            "medium",
            "low",
            "unknown"
          ]
        },
        "emotion": {
          "enum": [
            "neutral",
            "happy",
            "sad",
            "angry",
            "fearful",
            "tense"
          ]
        },
        "emotion_confidence": {
          "enum": [
            "high",
            "medium",
            "low",
            "unknown"
          ]
        },
        "delivery": {
          "enum": [
            "normal",
            "whisper",
            "shout",
            "inner_monologue"
          ]
        },
        "attribution": {
          "$ref": "#/$defs/attribution"
        },
        "pause_before_ms": {
          "type": "integer",
          "minimum": 0
        },
        "pause_after_ms": {
          "type": "integer",
          "minimum": 0
        },
        "manual_override": {
          "type": "boolean"
        }
      }
    },
    "issue": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "severity",
        "segment_id",
        "evidence_summary",
        "evidence_digest",
        "taxonomy_version"
      ],
      "properties": {
        "code": {
          "enum": [
            "W_SPEAKER_MEDIUM_CONFIDENCE",
            "W_NEW_ANONYMOUS_SPEAKER",
            "W_GENERIC_VOICE_FALLBACK",
            "W_MANUAL_OVERRIDE_INHERITED",
            "W_PRONUNCIATION_SOFT_FALLBACK",
            "W_CLOUD_ASSISTED_USED",
            "W_SCENE_BOUNDARY_MEDIUM_CONFIDENCE",
            "B_SPEAKER_UNKNOWN",
            "B_SPEAKER_LOW_CONFIDENCE",
            "B_CHARACTER_ALIAS_CONFLICT",
            "B_CHARACTER_REFERENCE_INVALID",
            "B_ANONYMOUS_IDENTITY_CONFLICT",
            "B_CASTING_TARGET_UNRESOLVED",
            "B_VOICE_MISSING",
            "B_VOICE_VERSION_UNAVAILABLE",
            "B_VOICE_RIGHTS_UNAVAILABLE",
            "B_PRONUNCIATION_HARD_CONFLICT",
            "B_CLOUD_DECISION_UNAVAILABLE"
          ]
        },
        "severity": {
          "enum": [
            "warning",
            "blocker"
          ]
        },
        "segment_id": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "evidence_summary": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 500
            },
            {
              "type": "null"
            }
          ]
        },
        "evidence_digest": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "taxonomy_version": {
          "const": "narration-review-taxonomy/1"
        }
      }
    },
    "approval": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "request_id",
        "actor_type",
        "actor_id",
        "approved_at"
      ],
      "properties": {
        "kind": {
          "enum": [
            "auto_no_blockers",
            "manual_after_review"
          ]
        },
        "request_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "actor_type": {
          "enum": [
            "owner",
            "system",
            "service"
          ]
        },
        "actor_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "approved_at": {
          "type": "string",
          "format": "date-time",
          "pattern": "(?:Z|\\+00:00)$"
        }
      }
    }
  },
