            {
              "title": "江晓棠",
              "content": "{\"character_id\": \"aacd291c-b19c-42c3-9388-81e1018a729f\", \"character_instance_id\": \"f4f14ab4-f122-41cb-8ed4-3b176d0a1f65\", \"display_label\": \"\", \"instance\": {\"age_at_story_start_note\": \"二十八岁\", \"flaws\": [], \"goals\": [\"在暴雨持续期间，为林澈提供尽量可靠的封路与气象信息，并阻止他单独做出无法回头的决定。\"], \"personality\": \"理性、爱用数据说话，说话时常带冷幽默；越紧张越能把话说得平稳；心里记挂林澈，却不愿让他因为自己的关心而分心。\", \"public_identity\": \"林澈旧日同窗，现为地方气象台值班员，通过断断续续的短波与林澈保持联系。\", \"schema_version\": \"character-instance-profile/2\", \"secrets\": []}, \"root\": {\"description\": \"江晓棠与林澈自大学气象观测社团相识，毕业后各奔东西，她留在地方台站。塌方发生后，她成为林澈与外界少数能通信的人之一。她一边报降雨量与塌方点坐标，一边察觉林澈在电话里越来越沉默，话里的空白越来越长。她答应替林澈查旧档案，却提醒他：纸面证据最怕被人顺手补一笔。\", \"details\": {\"gender\": \"女\"}, \"name\": \"江晓棠\", \"role_type\": \"supporting\"}}",
