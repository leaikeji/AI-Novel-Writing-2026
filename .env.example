POSTGRES_DB=ai_novel_world_2026
POSTGRES_USER=ai_novel
POSTGRES_PASSWORD=replace-with-a-local-secret

# T1-B provides a private technical runtime, but product TTS remains disabled
# until T4-GATE. `--profile tts` starts only the isolated runtime services.
COMPOSE_PROFILES=
AI_NOVEL_TTS_RUNTIME_ENABLED=false
# Keep the product gate off until T4-GATE evidence passes.  This flag never
# carries a secret; the HMAC keyring itself lives only in qwenpaw-secrets.
AI_NOVEL_TTS_PRODUCT_ENABLED=false
# Pre-release T4-K may start the same in-process production worker while all
# public T4 capabilities stay hidden. Never enable this together with PRODUCT
# or REFERENCE_CLONE until an independent reference-clone validation gate exists.
# Its private token is a 0600 file in the named secret volume, never an env value.
AI_NOVEL_TTS_VALIDATION_ENABLED=false
# Required only for one hidden T4-K run. Use canonical UUIDs for the dedicated
# test novel/chapter and a UTC expiry no more than 24 hours in the future.
AI_NOVEL_TTS_VALIDATION_NOVEL_ID=
AI_NOVEL_TTS_VALIDATION_DOCUMENT_ID=
AI_NOVEL_TTS_VALIDATION_EXPIRES_AT=
AI_NOVEL_TTS_REFERENCE_CLONE_ENABLED=false
MOSS_TTS_SIDECAR_IMAGE=ai-novel-world/moss-tts-sidecar:t1-b-linux-arm64
MOSS_TTS_MODEL_TREE_SHA256=92419b269673cd698afab06ef0e3f0b60673862c86190cc6c57ed010db9aca98
MOSS_TTS_SOURCE_TREE_SHA256=547f61c24427a59d802cc31dfe532e135303b6b9f71469be19a7f35acd5d4c94

# The provisioner creates the same token atomically in a private host file and
# the dedicated named secret volume. No token value/path belongs in `.env`,
# URLs, logs, evidence, or Git; destroy both copies after the bounded run.
