{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-novel-world.local/schemas/narration-manifest-2.0.json",
  "title": "Narration Manifest 2.0 wire contract",
  "description": "T0-G frozen public wire shape. Cross-field ready-window invariants are additionally enforced by the TypeScript validator.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "edition_id",
    "chapter_id",
    "source_revision_id",
    "source_sha256",
    "buffer_policy",
    "manifest_revision",
    "etag",
    "generated_at",
    "status",
    "ready_prefix_count",
    "default_start_ready",
    "last_playable_start_ordinal",
    "ready_ranges",
    "segments"
  ],
  "properties": {
    "schema_version": { "const": "narration-manifest/2.0" },
    "edition_id": { "$ref": "#/$defs/non_empty_string" },
    "chapter_id": { "$ref": "#/$defs/non_empty_string" },
    "source_revision_id": { "$ref": "#/$defs/non_empty_string" },
    "source_sha256": { "$ref": "#/$defs/sha256" },
    "buffer_policy": { "$ref": "#/$defs/buffer_policy" },
    "manifest_revision": { "type": "integer", "minimum": 1 },
    "etag": { "$ref": "#/$defs/strong_etag" },
    "generated_at": { "type": "string", "format": "date-time" },
    "status": {
      "enum": ["pending", "partial_ready", "ready", "failed", "cancelled"]
    },
    "ready_prefix_count": { "type": "integer", "minimum": 0 },
    "default_start_ready": { "type": "boolean" },
    "last_playable_start_ordinal": {
      "type": ["integer", "null"],
      "minimum": 0
    },
    "ready_ranges": {
      "type": "array",
      "items": { "$ref": "#/$defs/ready_range" }
    },
    "segments": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/segment" }
    }
  },
  "$defs": {
    "non_empty_string": { "type": "string", "minLength": 1 },
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "strong_etag": {
      "type": "string",
      "pattern": "^\"[a-f0-9]{64}\"$"
    },
    "controlled_media_url": {
      "type": "string",
      "pattern": "^/api/ai-novel-world-2026/[A-Za-z0-9_~-]+(?:/[A-Za-z0-9_~-]+)*$"
    },
    "buffer_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "minimum_segments",
        "minimum_duration_ms",
        "target_segments",
        "chapter_end_exception"
      ],
      "properties": {
        "version": { "$ref": "#/$defs/non_empty_string" },
        "minimum_segments": { "type": "integer", "minimum": 1 },
        "minimum_duration_ms": { "type": "integer", "minimum": 0 },
        "target_segments": { "type": "integer", "minimum": 1 },
        "chapter_end_exception": { "type": "boolean" }
      }
    },
    "ready_range": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "start_ordinal",
        "end_ordinal_exclusive",
        "segment_count",
        "duration_ms",
        "last_playable_start_ordinal"
      ],
      "properties": {
        "start_ordinal": { "type": "integer", "minimum": 0 },
        "end_ordinal_exclusive": { "type": "integer", "minimum": 1 },
        "segment_count": { "type": "integer", "minimum": 1 },
        "duration_ms": { "type": "number", "exclusiveMinimum": 0 },
        "last_playable_start_ordinal": { "type": "integer", "minimum": 0 }
      }
    },
    "audio": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "url",
        "actual_sha256",
        "duration_ms",
        "sample_rate",
        "channels",
        "etag"
      ],
      "properties": {
        "url": { "$ref": "#/$defs/controlled_media_url" },
        "actual_sha256": { "$ref": "#/$defs/sha256" },
        "duration_ms": { "type": "number", "exclusiveMinimum": 0 },
        "sample_rate": { "type": "integer", "minimum": 1 },
        "channels": { "type": "integer", "minimum": 1 },
        "etag": { "$ref": "#/$defs/strong_etag" }
      }
    },
    "failure": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "retryable", "message"],
      "properties": {
        "code": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9_]*$",
          "maxLength": 96
        },
        "retryable": { "type": "boolean" },
        "message": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        }
      }
    },
    "segment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "segment_id",
        "ordinal",
        "paragraph_ordinal",
        "source_block_key",
        "source_start_utf16",
        "source_end_utf16",
        "gap_after_ms",
        "render_status",
        "audio",
        "failure"
      ],
      "properties": {
        "segment_id": { "$ref": "#/$defs/non_empty_string" },
        "ordinal": { "type": "integer", "minimum": 0 },
        "paragraph_ordinal": { "type": "integer", "minimum": 0 },
        "source_block_key": { "$ref": "#/$defs/non_empty_string" },
        "source_start_utf16": { "type": "integer", "minimum": 0 },
        "source_end_utf16": { "type": "integer", "minimum": 1 },
        "gap_after_ms": { "type": "integer", "minimum": 0 },
        "render_status": {
          "enum": ["pending", "queued", "rendering", "ready", "failed", "cancelled"]
        },
        "audio": {
          "oneOf": [
            { "$ref": "#/$defs/audio" },
            { "type": "null" }
          ]
        },
        "failure": {
          "oneOf": [
            { "$ref": "#/$defs/failure" },
            { "type": "null" }
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": { "render_status": { "const": "ready" } },
            "required": ["render_status"]
          },
          "then": {
            "properties": {
              "audio": { "$ref": "#/$defs/audio" },
              "failure": { "type": "null" }
            }
          }
        },
        {
          "if": {
            "properties": { "render_status": { "const": "failed" } },
            "required": ["render_status"]
          },
          "then": {
            "properties": {
              "audio": { "type": "null" },
              "failure": { "$ref": "#/$defs/failure" }
            }
          }
        },
        {
          "if": {
            "properties": {
              "render_status": {
                "enum": ["pending", "queued", "rendering", "cancelled"]
              }
            },
            "required": ["render_status"]
          },
          "then": {
            "properties": {
              "audio": { "type": "null" },
              "failure": { "type": "null" }
            }
          }
        }
      ]
    }
  }
}
